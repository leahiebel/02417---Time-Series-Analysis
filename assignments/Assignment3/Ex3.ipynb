    "axes[2].set_xlabel('Lag k (hours)')\n",
    "axes[2].set_ylabel('Partial autocorrelation')\n",
    "axes[2].set_xticks(np.arange(0, 41, 5))\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(model_arx4.summary())"
