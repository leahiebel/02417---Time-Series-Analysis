    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import statsmodels.api as sm\n",
    "from statsmodels.graphics.tsaplots import plot_acf, plot_pacf\n",
    "\n",
    "p = 4\n",
    "\n",
    "feature_cols = (\n",
    "    [f'Ph.l{k}' for k in range(1, p + 1)] +\n",
    "    [f'Tdelta.l{k}' for k in range(0, p)] +\n",
    "    [f'Gv.l{k}' for k in range(0, p)]\n",
    ")\n",
    "\n",
    "train_df = df.iloc[:167].copy()\n",
    "data_p = train_df[['Ph'] + feature_cols].dropna().copy()\n",
    "\n",
    "y = data_p['Ph']\n",
    "X = data_p[feature_cols]   # no intercept\n",
    "\n",
    "model_arx4 = sm.OLS(y, X).fit()\n",
    "resid_arx4 = model_arx4.resid\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 4.8))\n",
    "\n",
    "axes[0].plot(data_p.index, resid_arx4, color='tab:red', linewidth=1.3)\n",
    "axes[0].axhline(0, color='black', linewidth=1)\n",
    "axes[0].set_title('ARX(4) one-step residuals')\n",
    "axes[0].set_xlabel('Time index (hour)')\n",
    "axes[0].set_ylabel('Residual (W)')\n",
    "axes[0].grid(True, alpha=0.3)\n",
    "\n",
    "plot_acf(resid_arx4, lags=40, ax=axes[1], title='ACF of ARX(4) one-step residuals')\n",
    "axes[1].set_xlabel('Lag k (hours)')\n",
    "axes[1].set_ylabel('Autocorrelation')\n",
    "axes[1].set_xticks(np.arange(0, 41, 5))\n",
    "\n",
