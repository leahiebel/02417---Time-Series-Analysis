    "### 3.4. Estimate the impulse response from $T_{delta}$ and $G_v$ to $P_h$ make it up to lag 10. Present it for both variables in plots and comment."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 78,
   "id": "1c590ca1",
   "metadata": {},
   "outputs": [],
   "source": [
    "import statsmodels.api as sm"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "77a097d1",
   "metadata": {},
   "outputs": [],
   "source": [
    "def estimate_irf(target, exogenous, max_lag=10):\n",
    "    # Create a DataFrame for the lagged exogenous variables\n",
    "    lag_cols = pd.DataFrame(index=target.index)\n",
    "    for i in range(max_lag + 1):\n",
    "        lag_cols[f'lag_{i}'] = exogenous.shift(i)\n",
    "    \n",
    "    valid_data = pd.concat([target, lag_cols], axis=1).dropna()\n",
    "    \n",
    "    y = valid_data[target.name]\n",
    "    X = valid_data.drop(columns=[target.name])\n",
    "    X = sm.add_constant(X) # Include intercept\n",
    "    \n",
    "    model = sm.OLS(y, X).fit()\n",
    "    return model.params[1:], model.bse[1:]\n",
    "\n",
    "# Calculate IRF\n",
    "irf_tdelta, stderr_tdelta = estimate_irf(train_df['Ph'], train_df['Tdelta'], max_lag=10)\n",
    "irf_gv, stderr_gv = estimate_irf(train_df['Ph'], train_df['Gv'], max_lag=10)"
   ]
