    "df = pd.read_csv(r\"C:\\Users\\leahi\\Documents\\DTU\\Time Series Analysis\\assignments\\Assignment3\\assignment3_2026\\box_data_60min.csv\")\n",
    "df[\"tdate\"] = pd.to_datetime(df[\"tdate\"])\n",
    "\n",
    "train_size = 167\n",
    "test_size = 64\n",
    "\n",
    "train_df = df.iloc[:train_size].copy()\n",
    "test_df = df.iloc[train_size:train_size + test_size].copy()\n",
    "\n",
    "# -----------------------------\n",
    "# 3. Fit ARX(p) on training set\n",
    "# -----------------------------\n",
    "feature_cols = (\n",
    "    [f\"Ph.l{k}\" for k in range(1, p_sel + 1)] +\n",
    "    [f\"Tdelta.l{k}\" for k in range(0, p_sel)] +\n",
    "    [f\"Gv.l{k}\" for k in range(0, p_sel)]\n",
    ")\n",
    "\n",
    "train_fit = train_df[[\"Ph\"] + feature_cols].dropna().copy()\n",
    "\n",
    "y_train = train_fit[\"Ph\"]\n",
    "X_train = train_fit[feature_cols]   # NO intercept\n",
    "\n",
    "model_sel = sm.OLS(y_train, X_train).fit()\n",
    "\n",
    "print(f\"Selected order: p = {p_sel}\")\n",
    "print(model_sel.params)\n",
    "\n",
    "# -----------------------------\n",
    "# 4. Dynamic multi-step simulation\n",
    "# -----------------------------\n",
    "n_total = len(df)\n",
    "ph_sim = np.full(n_total, np.nan)\n",
    "\n",
    "# Warm start with observed values for first p points\n",
    "ph_sim[:p_sel] = df[\"Ph\"].iloc[:p_sel].values\n",
    "\n",
    "for t in range(p_sel, n_total):\n",
    "    row = {}\n",
    "\n",
    "    # AR part: use previous SIMULATED values\n",
    "    for lag in range(1, p_sel + 1):\n",
    "        row[f\"Ph.l{lag}\"] = ph_sim[t - lag]\n",
    "\n",
    "    # X part: use observed inputs\n",
    "    for lag in range(0, p_sel):\n",
    "        row[f\"Tdelta.l{lag}\"] = df[\"Tdelta\"].iloc[t - lag]\n",
    "        row[f\"Gv.l{lag}\"] = df[\"Gv\"].iloc[t - lag]\n",
    "\n",
    "    x_row = pd.DataFrame([row], columns=feature_cols)\n",
    "    ph_sim[t] = model_sel.predict(x_row).iloc[0]\n",
    "\n",
    "# -----------------------------\n",
    "# 5. Collect results\n",
    "# -----------------------------\n",
    "sim_df = df.copy()\n",
    "sim_df[\"Ph_sim\"] = ph_sim\n",
    "sim_df[\"sim_resid\"] = sim_df[\"Ph\"] - sim_df[\"Ph_sim\"]\n",
    "\n",
    "# Test period: t = 168,...,231  <=>  Python indices 167,...,230\n",
    "test_start = 167\n",
    "test_end = 230\n",
    "\n",
    "res_test = sim_df.iloc[test_start:test_end + 1][\"sim_resid\"]\n",
    "rmse_sim_test = float(np.sqrt(np.mean(res_test**2)))\n",
    "\n",
    "print(f\"Test RMSE (simulation, t=168..231): {rmse_sim_test:.4f}\")\n",
    "print(f\"Computed over N = {len(res_test)} points\")\n",
    "\n",
    "# -----------------------------\n",
    "# 6. Plot\n",
    "# -----------------------------\n",
    "plt.figure(figsize=(12, 5))\n",
    "plt.plot(sim_df.index, sim_df[\"Ph\"], label=\"Observed $P_h$\", linewidth=1.6)\n",
    "plt.plot(sim_df.index, sim_df[\"Ph_sim\"], \"--\", label=f\"Simulated $\\\\hat P_h$ (ARX order {p_sel})\", linewidth=1.6)\n",
    "plt.axvline(train_size - 1, color=\"black\", linestyle=\":\", linewidth=1.2, label=\"Train/Test split\")\n",
    "plt.title(\"Multi-step ARX simulation over full period\")\n",
    "plt.xlabel(\"Time index (hour)\")\n",
    "plt.ylabel(\"$P_h$\")\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "sim_results = {\n",
    "    \"order_selected\": p_sel,\n",
    "    \"model\": model_sel,\n",
    "    \"sim_df\": sim_df,\n",
    "    \"rmse_test_sim\": rmse_sim_test\n",
    "}"
   ]
